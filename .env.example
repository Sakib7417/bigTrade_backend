NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/investment_db

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

MIN_INVESTMENT=100
MIN_WITHDRAWAL=10

WITHDRAWAL_FEE_PERCENT=5
EARLY_PRINCIPAL_PENALTY_PERCENT=10

DIRECT_COMMISSION_PERCENT=5

MIN_ROI_PERCENT=6
MAX_ROI_PERCENT=12

# Daily ROI admin range — admin sets any rate in this band per working day
DAILY_ROI_MIN_PCT=0.1
DAILY_ROI_MAX_PCT=1.0

# ROI credit window (24h) — queued payouts run inside this window
# ROI_PAYOUT_START_HOUR=18
# ROI_PAYOUT_END_HOUR=20

MAX_REFERRAL_LEVEL=20

ADMIN_EMAIL=
ADMIN_PASSWORD=

CORS_ORIGIN=*

# Optional: seed a default global ROI for a period
# SEED_GLOBAL_ROI_PERCENT=8
# SEED_GLOBAL_ROI_PERIOD=2026-10

# Crypto deposits (BSC testnet USDT)
BLOCKCHAIN_NETWORK=bsc-testnet
USDT_CONTRACT_ADDRESS=0x1F71139BACbf9Ab15d239342f7783C69951736f7
BLOCKCHAIN_RPC_URL=https://bsc-testnet-rpc.publicnode.com
BLOCKCHAIN_REQUIRED_CONFIRMATIONS=12
USDT_DECIMALS=18
PLATFORM_DEPOSIT_WALLET=

# Tron (TRC20) deposits — Nile testnet; use https://api.trongrid.io + mainnet USDT for prod
TRON_RPC_URL=https://nile.trongrid.io
TRON_USDT_CONTRACT=TXLAQ63Xg1NAzckPwKHvzw7CSEmLMEqcdj
TRON_REQUIRED_CONFIRMATIONS=19
TRON_USDT_DECIMALS=6

# Brevo (Sendinblue) — transactional email for OTP verification
# xsmtpsib- key → SMTP relay (needs BREVO_SMTP_USER); xkeysib- key → REST API
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
OTP_EXPIRY_MINUTES=10
BREVO_SMTP_USER=
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
