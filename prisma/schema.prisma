generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum InvestmentStatus {
  ACTIVE
  INACTIVE
  CAPPED
  COMPLETED
  CANCELLED
}

enum TransactionType {
  DEPOSIT
  INVESTMENT
  ROI
  DIRECT_COMMISSION
  LEVEL_COMMISSION
  WITHDRAWAL
  WITHDRAWAL_FEE
  TOP_UP
  REFUND
  ADMIN_ADJUSTMENT
  RANK_REWARD
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum CommissionType {
  DIRECT
  LEVEL
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum RoiType {
  GLOBAL
  USER_CUSTOM
  INVESTMENT_CUSTOM
}

model User {
  id              String      @id @default(cuid())
  name            String
  email           String      @unique
  mobile          String      @unique
  passwordHash    String
  role            UserRole    @default(USER)
  referralCode    String      @unique
  referredBy      User?       @relation("UserReferrals", fields: [referredById], references: [id])
  referredById    String?
  referrals       User[]      @relation("UserReferrals")
  status          UserStatus  @default(ACTIVE)
  emailVerifiedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  wallet          Wallet?
  walletTransactions WalletTransaction[]
  investments     Investment[]
  refreshTokens   RefreshToken[]
  commissions     Commission[] @relation("CommissionRecipient")
  sourcedCommissions Commission[] @relation("CommissionSource")
  withdrawals     Withdrawal[]
  cryptoDeposits  CryptoDeposit[]
  roiPayouts      RoiPayout[]
  dailyRoiExclusions DailyRoiExclusion[]
  supportTickets  SupportTicket[]
  rankRewards     RankReward[]
  roiEarnings     RoiEarning[]
  customRois      RoiConfiguration[]
  auditLogs       AuditLog[]  @relation("AdminAuditLogs")
  receivedAuditLogs AuditLog[] @relation("TargetAuditLogs")

  @@index([email])
  @@index([mobile])
  @@index([referralCode])
  @@index([referredById])
  @@index([status])
}

model RefreshToken {
  id           String   @id @default(cuid())
  token        String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Wallet {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  availableBalance Decimal  @default(0) @db.Decimal(20, 2)
  lockedBalance    Decimal  @default(0) @db.Decimal(20, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  transactions     WalletTransaction[]

  @@index([userId])
}

model WalletTransaction {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet          Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  walletId        String
  type            TransactionType
  amount          Decimal           @db.Decimal(20, 2)
  currency        String            @default("USD")
  direction       String            // "CREDIT" or "DEBIT"
  referenceType   String?           // "INVESTMENT", "ROI", "COMMISSION", "WITHDRAWAL", etc.
  referenceId     String?
  status          TransactionStatus @default(COMPLETED)
  description     String?
  metadata        Json?
  idempotencyKey  String?           @unique
  createdAt       DateTime          @default(now())

  @@index([userId])
  @@index([walletId])
  @@index([type])
  @@index([createdAt])
  @@index([referenceType, referenceId])
}

model Investment {
  id                        String            @id @default(cuid())
  userId                    String
  user                      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount                    Decimal           @db.Decimal(20, 2)
  principal                 Decimal           @db.Decimal(20, 2)
  status                    InvestmentStatus  @default(ACTIVE)
  startedAt                 DateTime          @default(now())
  maturityDate              DateTime?
  totalRoiEarned            Decimal           @default(0) @db.Decimal(20, 2)
  totalCommissionGenerated  Decimal           @default(0) @db.Decimal(20, 2)
  earningCap                Decimal           @db.Decimal(20, 2)
  customRoiConfigurations   RoiConfiguration[]
  roiEarnings               RoiEarning[]
  cycles                    InvestmentCycle[]
  principalWithdrawals      Withdrawal[]
  roiPayouts                RoiPayout[]
  idempotencyKey            String?           @unique
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  @@index([userId])
  @@index([status])
  @@index([startedAt])
}

model InvestmentCycle {
  id               String   @id @default(cuid())
  investmentId     String
  investment       Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  cycleNumber      Int
  amount           Decimal  @db.Decimal(20, 2)
  earningCap       Decimal  @db.Decimal(20, 2)
  totalRoiEarned   Decimal  @default(0) @db.Decimal(20, 2)
  status           InvestmentStatus @default(ACTIVE)
  startedAt        DateTime @default(now())
  completedAt      DateTime?
  createdAt        DateTime @default(now())

  @@index([investmentId])
}

model RoiConfiguration {
  id                String    @id @default(cuid())
  type              RoiType
  roiPercent        Decimal   @db.Decimal(5, 2)
  period            String    // Format: "YYYY-MM" for monthly
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  investmentId      String?
  investment        Investment? @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([type, period, userId, investmentId])
  @@index([type])
  @@index([period])
  @@index([userId])
  @@index([investmentId])
}

model RoiEarning {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  investmentId    String
  investment      Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  roiPercent      Decimal  @db.Decimal(5, 2)
  roiAmount       Decimal  @db.Decimal(20, 2)
  period          String   // Format: "YYYY-MM"
  roiConfigId     String?
  createdAt       DateTime @default(now())

  @@unique([investmentId, period])
  @@index([userId])
  @@index([investmentId])
  @@index([period])
}

model CommissionLevel {
  id          Int      @id @default(autoincrement())
  level       Int      @unique
  percent     Decimal  @db.Decimal(5, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([level])
}

model Commission {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation("CommissionRecipient", fields: [userId], references: [id], onDelete: Cascade)
  sourceUserId    String
  sourceUser      User            @relation("CommissionSource", fields: [sourceUserId], references: [id], onDelete: Cascade)
  type            CommissionType
  level           Int?
  percent         Decimal         @db.Decimal(5, 2)
  amount          Decimal         @db.Decimal(20, 2)
  referenceType   String          // "INVESTMENT", "ROI"
  referenceId     String
  description     String?
  createdAt       DateTime        @default(now())

  // Idempotency: a user can only receive one commission per type per reference event
  @@unique([userId, type, referenceType, referenceId])
  @@index([userId])
  @@index([sourceUserId])
  @@index([type])
  @@index([referenceType, referenceId])
}

// One-time rank milestone reward — (userId, rank) unique means it can never
// be paid twice to the same user for the same rank.
model RankReward {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank      Int
  reward    Decimal  @db.Decimal(20, 2)
  legsUsed  Json?    // snapshot of the legs that qualified (audit trail)
  createdAt DateTime @default(now())

  @@unique([userId, rank])
  @@index([userId])
}

enum WithdrawalKind {
  BALANCE
  PRINCIPAL
}

enum CryptoDepositStatus {
  PENDING
  CONFIRMED
  CREDITED
  REJECTED
}

enum DailyRoiRateStatus {
  DRAFT
  PUBLISHED
  PROCESSED
  LOCKED
}

enum RoiPayoutStatus {
  CREDITED
  CAPPED
  SKIPPED
  FAILED
}

model DailyRoiRate {
  id           String             @id @default(cuid())
  roiDate      DateTime           @unique @db.Date
  ratePercent  Decimal            @db.Decimal(12, 6)
  status       DailyRoiRateStatus @default(DRAFT)
  reason       String?
  previousRate Decimal?           @db.Decimal(12, 6)
  createdBy    String?
  publishedBy  String?
  publishedAt  DateTime?
  processedAt  DateTime?
  processRequested Boolean @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  payouts      RoiPayout[]

  @@index([status])
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

model SupportTicket {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject    String
  message    String
  status     TicketStatus @default(OPEN)
  adminReply String?
  repliedBy  String?
  repliedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId])
  @@index([status])
}

model DailyRoiExclusion {
  id         String   @id @default(cuid())
  roiDate    DateTime @db.Date
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason     String?
  createdBy  String?
  createdAt  DateTime @default(now())

  @@unique([roiDate, userId])
  @@index([roiDate])
}

model RoiPayout {
  id                  String          @id @default(cuid())
  dailyRoiRateId      String
  dailyRoiRate        DailyRoiRate    @relation(fields: [dailyRoiRateId], references: [id], onDelete: Cascade)
  roiDate             DateTime        @db.Date
  userId              String
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  investmentId        String
  investment          Investment      @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  ratePercent         Decimal         @db.Decimal(12, 6)
  eligiblePrincipal   Decimal         @db.Decimal(20, 2)
  calculatedAmount    Decimal         @db.Decimal(20, 6)
  creditedAmount      Decimal         @default(0) @db.Decimal(20, 6)
  cycleIndex          Int
  status              RoiPayoutStatus
  failureReason       String?
  walletTransactionId String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([investmentId, roiDate])
  @@index([userId])
  @@index([roiDate])
  @@index([status])
}

model CryptoDeposit {
  id                  String              @id @default(cuid())
  userId              String
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  txHash              String              @unique
  fromAddress         String
  toAddress           String
  amount              Decimal             @db.Decimal(20, 6)
  asset               String              @default("USDT")
  network             String              @default("bsc-testnet")
  confirmations       Int                 @default(0)
  status              CryptoDepositStatus @default(PENDING)
  walletTransactionId String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  purpose    String    @default("REGISTER")
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
}

model DepositWallet {
  id        String   @id @default(cuid())
  network   String // BEP20 | TRC20
  address   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([network, address])
  @@index([network, active])
}

model Withdrawal {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            WithdrawalKind   @default(BALANCE)
  amount          Decimal          @db.Decimal(20, 2)
  fee             Decimal          @db.Decimal(20, 2)
  netAmount       Decimal          @db.Decimal(20, 2)
  principalPenalty Decimal         @default(0) @db.Decimal(20, 2)
  investmentId    String?
  investment      Investment?      @relation(fields: [investmentId], references: [id], onDelete: SetNull)
  status          WithdrawalStatus @default(PENDING)
  rejectionReason String?
  destinationAddress String?
  payoutTxHash    String?          @unique
  bankDetails     Json?
  idempotencyKey  String?          @unique
  processedAt     DateTime?
  approvedBy      String?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model AuditLog {
  id           String   @id @default(cuid())
  adminId      String
  admin        User     @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: Cascade)
  action       String
  targetType   String?
  targetId     String?
  targetUserId String?
  targetUser   User?    @relation("TargetAuditLogs", fields: [targetUserId], references: [id], onDelete: SetNull)
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}
